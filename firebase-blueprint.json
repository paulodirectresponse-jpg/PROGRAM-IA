{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and tenant isolation data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Code workspace project owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "branch": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "name", "branch", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document isolated per UID"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Projects accessible and managed by owner"
    }
  }
}
