# PROGRAM-IA backend environment
# Nunca faça commit de um .env real.

APP_URL=""

# Firebase Auth do próprio PROGRAM-IA.
# Configure conforme o runtime/deploy. Firebase conectado pelos usuários aos projetos
# é uma integração separada dentro da aplicação.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""

# Persistência cloud canônica.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Compatibilidade de deploys antigos; prefira SUPABASE_SECRET_KEY quando disponível.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""

# Deve ser estável e idêntica em todos os runtimes que acessam os mesmos secrets.
SECRETS_MASTER_KEY=""
FORGE_REQUIRE_CLOUD_SYNC="true"
FORGE_DEVICE_ID=""

# Agent Engine permanece opt-in até a state machine/benchmark final.
AGENT_ENGINE_ENABLED="false"
FORGE_LLM_TIMEOUT_MS="180000"

# Compatibilidade para fluxos internos sem usuário autenticado.
# Providers de usuários autenticados devem ser configurados pela UI e pelo vault da conta;
# não dependem destas variáveis.
USEONEAI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL_ID=""
GEMINI_API_KEY=""

# GitHub host-level somente para tarefas internas explícitas.
# O fluxo normal do usuário usa a integração/secret da própria conta.
GITHUB_TOKEN=""
GITHUB_DEFAULT_OWNER=""
