# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LLM OpenAI-compatible Provider (e.g. UseOneAI, OpenAI, Groq, Ollama)
# Chaves e URLs configuradas com segurança no servidor
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.useoneai.app/v1"
OPENAI_MODEL_ID="chatgpt-5.5"

# GitHub Integration (Para commits, pull requests e sincronização reais)
# Deixar em branco para visualizar o estado transparente "Pendente de Configuração"
GITHUB_TOKEN=""
GITHUB_DEFAULT_OWNER=""

# Sincronização privada entre dispositivos. A service role existe somente no backend.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Obrigatório quando Supabase estiver configurado. Cadastre estes valores como secrets
# persistentes do serviço de deploy/Codespaces; não os recrie a cada runtime.
# Use exatamente a mesma chave em todos os backends para descriptografar credenciais sincronizadas.
SECRETS_MASTER_KEY="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_BYTES"
# Ative no backend publicado para impedir que ele inicie sem a infraestrutura de sync.
FORGE_REQUIRE_CLOUD_SYNC="true"
FORGE_DEVICE_ID=""

