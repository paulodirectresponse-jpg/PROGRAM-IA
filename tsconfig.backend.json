{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "moduleResolution": "NodeNext",
    "module": "NodeNext"
    ,"resolveJsonModule": true
